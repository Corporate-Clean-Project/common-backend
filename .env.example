# ------------------------------------------------------------------
# common-backend environment variables (DUMMY VALUES - replace me!)
# Copy this file to .env and fill in real credentials before deploy.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Comma separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=mongodb+srv://dummy_user:dummy_password@dummy-cluster.mongodb.net/top-pristine?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=dummy_access_secret_change_me_32_chars_min
JWT_REFRESH_SECRET=dummy_refresh_secret_change_me_32_chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Default admin user created by `npm run seed`
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@toppristine.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# SMTP / Nodemailer (dummy - e.g. AWS SES / SendGrid / Mailtrap in real deployment)
SMTP_HOST=smtp.dummy-mail-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=dummy_smtp_user
SMTP_PASSWORD=dummy_smtp_password
MAIL_FROM="Top Pristine <no-reply@toppristine.com>"

# Front-end URLs (used in emails / CORS / password reset links)
WEB_FRONTEND_URL=https://www.toppristine.com
ADMIN_FRONTEND_URL=https://admin.toppristine.com

# AWS (used by CI/CD only - dummy placeholders)
AWS_REGION=us-east-1
S3_UPLOADS_BUCKET=dummy-top-pristine-uploads
